<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <title>Balance Generale SYSCOHADA</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: Arial, Helvetica, sans-serif; font-size: 10px; color: #1a1a1a; background: #fff; }

    /* Header */
    .header { background: #1a237e; color: #fff; padding: 18px 24px; display: flex; justify-content: space-between; align-items: flex-start; }
    .header-left .company-name { font-size: 16px; font-weight: 700; letter-spacing: 0.5px; margin-bottom: 4px; }
    .header-left .company-details { font-size: 9px; opacity: 0.85; line-height: 1.6; }
    .header-right { text-align: right; }
    .header-right .doc-title { font-size: 20px; font-weight: 700; letter-spacing: 1px; }
    .header-right .doc-subtitle { font-size: 11px; opacity: 0.9; margin-top: 4px; }
    .header-right .doc-meta { font-size: 9px; opacity: 0.8; margin-top: 6px; line-height: 1.6; }

    /* Meta band */
    .meta-band { background: #e8eaf6; border-bottom: 2px solid #1a237e; padding: 8px 24px; display: flex; gap: 40px; font-size: 9px; color: #1a237e; font-weight: 600; }
    .meta-item span { font-weight: 400; color: #333; }

    /* Content */
    .content { padding: 12px 24px; }

    /* Class section */
    .class-section { margin-bottom: 18px; break-inside: avoid; }
    .class-header { background: #1a237e; color: #fff; padding: 6px 12px; font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.4px; display: flex; justify-content: space-between; align-items: center; }

    /* Table */
    table { width: 100%; border-collapse: collapse; }
    thead th { background: #3949ab; color: #fff; padding: 5px 10px; font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.3px; text-align: left; }
    thead th.right { text-align: right; }
    thead th.center { text-align: center; }

    tbody tr:nth-child(even) { background: #f5f7fa; }
    tbody tr:nth-child(odd) { background: #fff; }
    tbody td { padding: 3.5px 10px; font-size: 9.5px; border-bottom: 1px solid #e8eaf6; vertical-align: middle; }
    tbody td.num { color: #3949ab; font-weight: 600; width: 70px; font-family: monospace; }
    tbody td.libelle { max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    tbody td.montant { text-align: right; font-weight: 500; width: 110px; font-variant-numeric: tabular-nums; font-family: monospace; }
    tbody td.solde-d { text-align: right; font-weight: 600; color: #1a237e; width: 110px; font-family: monospace; }
    tbody td.solde-c { text-align: right; font-weight: 600; color: #c62828; width: 110px; font-family: monospace; }

    /* Class subtotal */
    .class-total-row td { background: #c5cae9; color: #1a237e; font-weight: 700; font-size: 9.5px; padding: 5px 10px; border-top: 2px solid #9fa8da; border-bottom: 2px solid #9fa8da; }
    .class-total-row td.right { text-align: right; font-family: monospace; }
    .class-total-row td.right-d { text-align: right; color: #1a237e; font-family: monospace; }
    .class-total-row td.right-c { text-align: right; color: #c62828; font-family: monospace; }

    /* Grand total */
    .grand-total { margin: 18px 0 12px; background: #1a237e; border-radius: 4px; overflow: hidden; }
    .grand-total table { margin: 0; }
    .grand-total thead th { background: #0d1557; font-size: 9.5px; }
    .grand-total tbody td { background: #e8eaf6 !important; color: #1a237e; font-weight: 700; font-size: 10px; padding: 7px 10px; font-family: monospace; }
    .grand-total tbody td.label { background: #1a237e !important; color: #fff; font-size: 10px; font-weight: 700; }
    .grand-total tbody td.d { text-align: right; color: #1a237e; }
    .grand-total tbody td.c { text-align: right; color: #c62828; }

    /* Equilibre badge */
    .equilibre-band { margin: 0 0 14px; padding: 8px 14px; border-radius: 4px; font-size: 10px; font-weight: 700; display: flex; align-items: center; gap: 8px; }
    .equilibre-band.ok { background: #e8f5e9; border: 1px solid #a5d6a7; color: #2e7d32; }
    .equilibre-band.ko { background: #ffebee; border: 1px solid #ef9a9a; color: #c62828; }
    .equilibre-band .icon { font-size: 14px; }

    /* Footer */
    .footer { margin-top: 20px; padding-top: 8px; border-top: 1px solid #ddd; text-align: center; font-size: 8px; color: #999; }
  </style>
</head>
<body>

  <!-- Header -->
  <div class="header">
    <div class="header-left">
      <div class="company-name">{{company.name}}</div>
      <div class="company-details">
        {{#if company.address.street}}<div>{{company.address.street}}</div>{{/if}}
        <div>{{company.address.city}}{{#if company.address.country}}, {{company.address.country}}{{/if}}</div>
        {{#if company.phone}}<div>Tel: {{company.phone}}</div>{{/if}}
        {{#if company.ninea}}<div>NINEA: {{company.ninea}}{{#if company.rccm}} — RC: {{company.rccm}}{{/if}}</div>{{/if}}
      </div>
    </div>
    <div class="header-right">
      <div class="doc-title">BALANCE GENERALE</div>
      <div class="doc-subtitle">Plan Comptable SYSCOHADA</div>
      <div class="doc-meta">
        <div>Genere le {{formatDate generatedAt}}</div>
        {{#if dateFrom}}<div>Du {{formatDate dateFrom}} au {{formatDate dateTo}}</div>{{/if}}
      </div>
    </div>
  </div>

  <!-- Meta band -->
  <div class="meta-band">
    <div class="meta-item">Comptes : <span>{{balance.totalComptes}}</span></div>
    <div class="meta-item">Total Debit : <span>{{formatMontant balance.totaux.totalDebit}} FCFA</span></div>
    <div class="meta-item">Total Credit : <span>{{formatMontant balance.totaux.totalCredit}} FCFA</span></div>
    <div class="meta-item">Soldes debiteurs : <span>{{formatMontant balance.totaux.totalSoldeDebiteur}} FCFA</span></div>
    <div class="meta-item">Soldes crediteurs : <span>{{formatMontant balance.totaux.totalSoldeCrediteur}} FCFA</span></div>
  </div>

  <div class="content">

    <!-- Equilibre indicator -->
    {{#if balance.isBalanced}}
    <div class="equilibre-band ok">
      <span class="icon">✓</span>
      Balance equilibree — Debit = Credit
    </div>
    {{else}}
    <div class="equilibre-band ko">
      <span class="icon">✗</span>
      Balance non equilibree — ecart : {{formatMontant balance.ecart}} FCFA
    </div>
    {{/if}}

    <!-- Comptes par classe -->
    {{#each balance.classesSorted}}
    <div class="class-section">
      <div class="class-header">
        <span>Classe {{this.classe}} — {{this.libelle}}</span>
        <span>{{this.comptes.length}} compte(s)</span>
      </div>
      <table>
        <thead>
          <tr>
            <th style="width:70px;">N° Compte</th>
            <th>Intitule</th>
            <th class="right" style="width:110px;">Mouv. Debit</th>
            <th class="right" style="width:110px;">Mouv. Credit</th>
            <th class="right" style="width:110px;">Solde Debiteur</th>
            <th class="right" style="width:110px;">Solde Crediteur</th>
          </tr>
        </thead>
        <tbody>
          {{#each this.comptes}}
          <tr>
            <td class="num">{{this.numero}}</td>
            <td class="libelle">{{this.libelle}}</td>
            <td class="montant">{{formatMontant this.totalDebit}}</td>
            <td class="montant">{{formatMontant this.totalCredit}}</td>
            <td class="solde-d">{{#if this.soldeDebiteur}}{{formatMontant this.soldeDebiteur}}{{else}}—{{/if}}</td>
            <td class="solde-c">{{#if this.soldeCrediteur}}{{formatMontant this.soldeCrediteur}}{{else}}—{{/if}}</td>
          </tr>
          {{/each}}
          <!-- Class subtotal -->
          <tr class="class-total-row">
            <td colspan="2">Sous-total Classe {{this.classe}}</td>
            <td class="right">{{formatMontant this.totalDebit}}</td>
            <td class="right">{{formatMontant this.totalCredit}}</td>
            <td class="right-d">{{formatMontant this.totalSoldeDebiteur}}</td>
            <td class="right-c">{{formatMontant this.totalSoldeCrediteur}}</td>
          </tr>
        </tbody>
      </table>
    </div>
    {{/each}}

    <!-- Grand total -->
    <div class="grand-total">
      <table>
        <thead>
          <tr>
            <th style="width:auto;"></th>
            <th class="right" style="width:110px;">Total Debit</th>
            <th class="right" style="width:110px;">Total Credit</th>
            <th class="right" style="width:110px;">Total Solde D.</th>
            <th class="right" style="width:110px;">Total Solde C.</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="label">TOTAUX GENERAUX</td>
            <td class="d">{{formatMontant balance.totaux.totalDebit}}</td>
            <td class="c">{{formatMontant balance.totaux.totalCredit}}</td>
            <td class="d">{{formatMontant balance.totaux.totalSoldeDebiteur}}</td>
            <td class="c">{{formatMontant balance.totaux.totalSoldeCrediteur}}</td>
          </tr>
        </tbody>
      </table>
    </div>

  </div>

  <!-- Footer -->
  <div class="footer">
    <p>{{company.name}}{{#if company.ninea}} — NINEA: {{company.ninea}}{{/if}}</p>
    <p>Document SYSCOHADA genere le {{formatDate generatedAt}} — Confidentiel</p>
  </div>

</body>
</html>
