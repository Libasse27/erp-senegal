<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <title>Relevé de Compte Client</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: Arial, Helvetica, sans-serif; font-size: 10px; color: #1a1a1a; background: #fff; }

    .header { background: #0d47a1; color: #fff; padding: 18px 24px; display: flex; justify-content: space-between; align-items: flex-start; }
    .header-left .company-name { font-size: 16px; font-weight: 700; margin-bottom: 4px; }
    .header-left .company-details { font-size: 9px; opacity: 0.85; line-height: 1.6; }
    .header-right { text-align: right; }
    .header-right .doc-title { font-size: 15px; font-weight: 700; }
    .header-right .doc-meta { font-size: 9px; opacity: 0.85; margin-top: 6px; line-height: 1.6; }

    .client-band { background: #e3f2fd; border-bottom: 2px solid #0d47a1; padding: 10px 24px; display: flex; gap: 32px; flex-wrap: wrap; }
    .client-band .field { display: flex; flex-direction: column; }
    .client-band .field-label { font-size: 8px; font-weight: 700; text-transform: uppercase; color: #1565c0; margin-bottom: 2px; }
    .client-band .field-value { font-size: 10px; font-weight: 600; color: #1a1a1a; }

    .kpi-row { display: flex; gap: 12px; padding: 14px 24px; background: #f5f7fa; border-bottom: 1px solid #e8eaf6; }
    .kpi-card { flex: 1; background: #fff; border: 1px solid #e8eaf6; border-radius: 4px; padding: 10px 14px; text-align: center; border-top: 3px solid #0d47a1; }
    .kpi-card .kpi-label { font-size: 8px; font-weight: 700; text-transform: uppercase; color: #666; margin-bottom: 5px; }
    .kpi-card .kpi-value { font-size: 14px; font-weight: 700; color: #0d47a1; }
    .kpi-card.green { border-top-color: #2e7d32; }
    .kpi-card.green .kpi-value { color: #2e7d32; }
    .kpi-card.red { border-top-color: #c62828; }
    .kpi-card.red .kpi-value { color: #c62828; }

    .content { padding: 0 24px 16px; }
    .section-title { background: #0d47a1; color: #fff; padding: 6px 12px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.4px; margin-top: 14px; }
    table { width: 100%; border-collapse: collapse; }
    thead th { background: #1565c0; color: #fff; padding: 6px 10px; font-size: 9px; font-weight: 700; text-transform: uppercase; }
    thead th.right { text-align: right; }
    thead th.center { text-align: center; }
    tbody tr:nth-child(even) { background: #f5f7fa; }
    tbody td { padding: 5px 10px; font-size: 9.5px; border-bottom: 1px solid #e8eaf6; }
    tbody td.right { text-align: right; font-weight: 600; }
    tbody td.center { text-align: center; }
    tbody tr.empty td { color: #aaa; font-style: italic; text-align: center; padding: 10px; }

    .badge { display: inline-block; padding: 2px 6px; border-radius: 3px; font-size: 8px; font-weight: 700; }
    .badge-success { background: #e8f5e9; color: #2e7d32; }
    .badge-warning { background: #fff8e1; color: #f57f17; }
    .badge-danger  { background: #ffebee; color: #c62828; }
    .badge-info    { background: #e3f2fd; color: #1565c0; }

    .totals-row td { background: #0d47a1; color: #fff; font-weight: 700; font-size: 10px; padding: 7px 10px; border: none; }
    .totals-row td.right { text-align: right; }

    .solde-band { margin: 16px 24px 0; padding: 10px 16px; border-radius: 4px; display: flex; align-items: center; justify-content: space-between; }
    .solde-band.positif { background: #ffebee; border-left: 4px solid #c62828; }
    .solde-band.negatif { background: #e8f5e9; border-left: 4px solid #2e7d32; }
    .solde-band .label { font-size: 11px; font-weight: 700; }
    .solde-band .amount { font-size: 16px; font-weight: 700; }
    .solde-band.positif .label, .solde-band.positif .amount { color: #c62828; }
    .solde-band.negatif .label, .solde-band.negatif .amount { color: #2e7d32; }

    .doc-footer { padding: 8px 24px; font-size: 8px; color: #666; display: flex; justify-content: space-between; border-top: 1px solid #e8eaf6; margin-top: 12px; }

    @media print { body { -webkit-print-color-adjust: exact; print-color-adjust: exact; } }
  </style>
</head>
<body>

  <div class="header">
    <div class="header-left">
      <div class="company-name">{{company.name}}</div>
      <div class="company-details">
        {{#if company.address.street}}{{company.address.street}}, {{/if}}{{company.address.city}}<br />
        {{#if company.phone}}Tél : {{company.phone}} &nbsp;|&nbsp; {{/if}}{{#if company.email}}{{company.email}}{{/if}}<br />
        {{#if company.ninea}}NINEA : {{company.ninea}}{{/if}}
      </div>
    </div>
    <div class="header-right">
      <div class="doc-title">RELEVÉ DE COMPTE CLIENT</div>
      <div class="doc-meta">
        Période : {{formatDate dateFrom}} — {{formatDate dateTo}}<br />
        Généré le {{formatDate generatedAt}}
      </div>
    </div>
  </div>

  <div class="client-band">
    <div class="field">
      <span class="field-label">Client</span>
      <span class="field-value">{{client.raisonSociale}}{{#unless client.raisonSociale}}{{client.firstName}} {{client.lastName}}{{/unless}}</span>
    </div>
    {{#if client.email}}
    <div class="field">
      <span class="field-label">Email</span>
      <span class="field-value">{{client.email}}</span>
    </div>
    {{/if}}
    {{#if client.phone}}
    <div class="field">
      <span class="field-label">Téléphone</span>
      <span class="field-value">{{client.phone}}</span>
    </div>
    {{/if}}
    {{#if client.ninea}}
    <div class="field">
      <span class="field-label">NINEA</span>
      <span class="field-value">{{client.ninea}}</span>
    </div>
    {{/if}}
    <div class="field">
      <span class="field-label">Période analysée</span>
      <span class="field-value">{{formatDate dateFrom}} au {{formatDate dateTo}}</span>
    </div>
  </div>

  <div class="kpi-row">
    <div class="kpi-card">
      <div class="kpi-label">Nb Factures</div>
      <div class="kpi-value">{{nbFactures}}</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Total Facturé (TTC)</div>
      <div class="kpi-value">{{formatMontant totalFacture}} FCFA</div>
    </div>
    <div class="kpi-card green">
      <div class="kpi-label">Total Encaissé</div>
      <div class="kpi-value">{{formatMontant totalPaye}} FCFA</div>
    </div>
    <div class="kpi-card red">
      <div class="kpi-label">Solde Dû</div>
      <div class="kpi-value">{{formatMontant solde}} FCFA</div>
    </div>
  </div>

  <div class="content">
    <!-- Factures -->
    <div class="section-title">Factures</div>
    <table>
      <thead>
        <tr>
          <th style="width:110px;">N° Facture</th>
          <th style="width:90px;" class="center">Date</th>
          <th style="width:90px;" class="center">Échéance</th>
          <th class="right">Montant HT</th>
          <th class="right">Montant TTC</th>
          <th class="right">Payé</th>
          <th class="center" style="width:80px;">Statut</th>
        </tr>
      </thead>
      <tbody>
        {{#if factures.length}}
          {{#each factures}}
          <tr>
            <td style="font-weight:600; color:#1565c0;">{{numero}}</td>
            <td class="center">{{formatDate dateFacture}}</td>
            <td class="center">{{formatDate dateEcheance}}</td>
            <td class="right">{{formatMontant totalHT}}</td>
            <td class="right" style="font-weight:700;">{{formatMontant totalTTC}}</td>
            <td class="right" style="color:#2e7d32;">{{formatMontant montantPaye}}</td>
            <td class="center">
              {{#eq statut "payee"}}<span class="badge badge-success">Payée</span>{{/eq}}
              {{#eq statut "partiellement_payee"}}<span class="badge badge-warning">Partiel</span>{{/eq}}
              {{#eq statut "envoyee"}}<span class="badge badge-info">Envoyée</span>{{/eq}}
              {{#eq statut "en_retard"}}<span class="badge badge-danger">En retard</span>{{/eq}}
              {{#eq statut "validee"}}<span class="badge badge-info">Validée</span>{{/eq}}
            </td>
          </tr>
          {{/each}}
          <tr class="totals-row">
            <td colspan="3"><strong>TOTAL FACTURES</strong></td>
            <td class="right">—</td>
            <td class="right">{{formatMontant totalFacture}}</td>
            <td class="right">{{formatMontant totalPaye}}</td>
            <td></td>
          </tr>
        {{else}}
          <tr class="empty"><td colspan="7">Aucune facture sur cette période</td></tr>
        {{/if}}
      </tbody>
    </table>

    <!-- Paiements -->
    {{#if paiements.length}}
    <div class="section-title" style="margin-top:16px;">Paiements Reçus</div>
    <table>
      <thead>
        <tr>
          <th style="width:110px;">N° Paiement</th>
          <th style="width:90px;" class="center">Date</th>
          <th>Mode de Paiement</th>
          <th>Référence</th>
          <th class="right">Montant</th>
        </tr>
      </thead>
      <tbody>
        {{#each paiements}}
        <tr>
          <td style="font-weight:600; color:#1565c0;">{{numero}}</td>
          <td class="center">{{formatDate dateValidation}}</td>
          <td>{{modePaiement}}</td>
          <td>{{reference}}</td>
          <td class="right" style="color:#2e7d32; font-weight:700;">{{formatMontant montant}} FCFA</td>
        </tr>
        {{/each}}
        <tr class="totals-row">
          <td colspan="4"><strong>TOTAL ENCAISSÉ</strong></td>
          <td class="right">{{formatMontant totalPaye}} FCFA</td>
        </tr>
      </tbody>
    </table>
    {{/if}}
  </div>

  <!-- Solde final -->
  <div class="solde-band {{#if soldeDu}}positif{{else}}negatif{{/if}}">
    <span class="label">SOLDE DÛ PAR LE CLIENT</span>
    <span class="amount">{{formatMontant solde}} FCFA</span>
  </div>

  <div class="doc-footer">
    <span>Relevé de compte — {{client.raisonSociale}}{{#unless client.raisonSociale}}{{client.firstName}} {{client.lastName}}{{/unless}} — Généré le {{formatDate generatedAt}}</span>
    <span>{{company.name}} — FCFA (XOF)</span>
  </div>

</body>
</html>
