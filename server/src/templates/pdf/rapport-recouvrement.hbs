<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <title>Rapport de Recouvrement</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: Arial, Helvetica, sans-serif; font-size: 10px; color: #1a1a1a; background: #fff; }

    .header { background: #b71c1c; color: #fff; padding: 18px 24px; display: flex; justify-content: space-between; align-items: flex-start; }
    .header-left .company-name { font-size: 16px; font-weight: 700; margin-bottom: 4px; }
    .header-left .company-details { font-size: 9px; opacity: 0.85; line-height: 1.6; }
    .header-right { text-align: right; }
    .header-right .doc-title { font-size: 15px; font-weight: 700; }
    .header-right .doc-meta { font-size: 9px; opacity: 0.85; margin-top: 6px; line-height: 1.6; }

    .meta-band { background: #ffebee; border-bottom: 2px solid #b71c1c; padding: 8px 24px; display: flex; gap: 24px; flex-wrap: wrap; font-size: 9px; color: #b71c1c; font-weight: 600; }

    .kpi-row { display: flex; gap: 12px; padding: 14px 24px; background: #f5f7fa; border-bottom: 1px solid #e8eaf6; }
    .kpi-card { flex: 1; background: #fff; border: 1px solid #e8eaf6; border-radius: 4px; padding: 10px 14px; text-align: center; border-top: 3px solid #b71c1c; }
    .kpi-card .kpi-label { font-size: 8px; font-weight: 700; text-transform: uppercase; color: #666; margin-bottom: 5px; }
    .kpi-card .kpi-value { font-size: 14px; font-weight: 700; color: #b71c1c; }
    .kpi-card.orange { border-top-color: #e65100; }
    .kpi-card.orange .kpi-value { color: #e65100; }
    .kpi-card.yellow { border-top-color: #f57f17; }
    .kpi-card.yellow .kpi-value { color: #f57f17; }

    .content { padding: 0 24px 16px; }
    .bucket-section { margin-top: 16px; }
    .bucket-header { padding: 6px 12px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.4px; color: #fff; }
    .bucket-current .bucket-header { background: #1565c0; }
    .bucket-30 .bucket-header { background: #f57f17; }
    .bucket-60 .bucket-header { background: #e65100; }
    .bucket-90 .bucket-header { background: #b71c1c; }
    .bucket-plus .bucket-header { background: #4a0000; }

    table { width: 100%; border-collapse: collapse; }
    thead th { color: #fff; padding: 6px 10px; font-size: 9px; font-weight: 700; text-transform: uppercase; }
    .bucket-current thead th { background: #1976d2; }
    .bucket-30 thead th { background: #fb8c00; }
    .bucket-60 thead th { background: #f4511e; }
    .bucket-90 thead th { background: #c62828; }
    .bucket-plus thead th { background: #6d0000; }
    thead th.right { text-align: right; }
    thead th.center { text-align: center; }
    tbody tr:nth-child(even) { background: #f5f7fa; }
    tbody td { padding: 5px 10px; font-size: 9.5px; border-bottom: 1px solid #e8eaf6; }
    tbody td.right { text-align: right; font-weight: 600; }
    tbody td.center { text-align: center; }
    tbody tr.empty td { color: #aaa; font-style: italic; text-align: center; padding: 10px; }

    .subtotal-row td { font-weight: 700; font-size: 9.5px; padding: 6px 10px; border: none; color: #fff; }
    .bucket-current .subtotal-row td { background: #1565c0; }
    .bucket-30 .subtotal-row td { background: #f57f17; }
    .bucket-60 .subtotal-row td { background: #e65100; }
    .bucket-90 .subtotal-row td { background: #b71c1c; }
    .bucket-plus .subtotal-row td { background: #4a0000; }
    .subtotal-row td.right { text-align: right; }

    .grand-total { margin: 16px 24px 0; padding: 12px 16px; background: #b71c1c; color: #fff; display: flex; justify-content: space-between; align-items: center; border-radius: 4px; }
    .grand-total .label { font-size: 12px; font-weight: 700; }
    .grand-total .amount { font-size: 18px; font-weight: 700; }

    .doc-footer { padding: 8px 24px; font-size: 8px; color: #666; display: flex; justify-content: space-between; border-top: 1px solid #e8eaf6; margin-top: 12px; }

    @media print { body { -webkit-print-color-adjust: exact; print-color-adjust: exact; } }
  </style>
</head>
<body>

  <div class="header">
    <div class="header-left">
      <div class="company-name">{{company.name}}</div>
      <div class="company-details">
        {{#if company.address.street}}{{company.address.street}}, {{/if}}{{company.address.city}}<br />
        {{#if company.phone}}Tél : {{company.phone}} &nbsp;|&nbsp; {{/if}}{{#if company.email}}{{company.email}}{{/if}}
      </div>
    </div>
    <div class="header-right">
      <div class="doc-title">RAPPORT DE RECOUVREMENT</div>
      <div class="doc-meta">
        Créances au {{formatDate generatedAt}}<br />
        Généré le {{formatDate generatedAt}}
      </div>
    </div>
  </div>

  <div class="meta-band">
    <span>État au : {{formatDate generatedAt}}</span>
    <span>Statuts : En cours, Partiel, En retard</span>
    <span>Unité : FCFA (XOF)</span>
  </div>

  <div class="kpi-row">
    <div class="kpi-card">
      <div class="kpi-label">Nb Créances</div>
      <div class="kpi-value">{{nbCreances}}</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-label">Total Dû (TTC)</div>
      <div class="kpi-value">{{formatMontant totalDu}} FCFA</div>
    </div>
    <div class="kpi-card orange">
      <div class="kpi-label">À échéance (0–30 j)</div>
      <div class="kpi-value">{{formatMontant total30}} FCFA</div>
    </div>
    <div class="kpi-card yellow">
      <div class="kpi-label">En retard (+30 j)</div>
      <div class="kpi-value">{{formatMontant totalRetard}} FCFA</div>
    </div>
  </div>

  <div class="content">

    {{#if buckets.current.length}}
    <div class="bucket-section bucket-current">
      <div class="bucket-header">Non échus — Paiement en attente</div>
      <table>
        <thead>
          <tr>
            <th style="width:110px;">N° Facture</th>
            <th>Client</th>
            <th class="center" style="width:90px;">Échéance</th>
            <th class="center" style="width:70px;">Jours</th>
            <th class="right">Montant Dû (FCFA)</th>
          </tr>
        </thead>
        <tbody>
          {{#each buckets.current}}
          <tr>
            <td style="font-weight:600; color:#1565c0;">{{numero}}</td>
            <td>{{clientNom}}</td>
            <td class="center">{{formatDate dateEcheance}}</td>
            <td class="center" style="color:#1565c0; font-weight:600;">{{daysOverdue}}</td>
            <td class="right">{{formatMontant montantDu}}</td>
          </tr>
          {{/each}}
          <tr class="subtotal-row">
            <td colspan="4">Sous-total Non échus</td>
            <td class="right">{{formatMontant totalCurrent}} FCFA</td>
          </tr>
        </tbody>
      </table>
    </div>
    {{/if}}

    {{#if buckets.1-30.length}}
    <div class="bucket-section bucket-30" style="margin-top:12px;">
      <div class="bucket-header">Retard 1 – 30 jours</div>
      <table>
        <thead>
          <tr>
            <th style="width:110px;">N° Facture</th>
            <th>Client</th>
            <th class="center" style="width:90px;">Échéance</th>
            <th class="center" style="width:70px;">Retard</th>
            <th class="right">Montant Dû (FCFA)</th>
          </tr>
        </thead>
        <tbody>
          {{#each buckets.1-30}}
          <tr>
            <td style="font-weight:600; color:#f57f17;">{{numero}}</td>
            <td>{{clientNom}}</td>
            <td class="center">{{formatDate dateEcheance}}</td>
            <td class="center" style="color:#e65100; font-weight:600;">{{daysOverdue}} j</td>
            <td class="right">{{formatMontant montantDu}}</td>
          </tr>
          {{/each}}
          <tr class="subtotal-row">
            <td colspan="4">Sous-total 1–30 jours</td>
            <td class="right">{{formatMontant total1_30}} FCFA</td>
          </tr>
        </tbody>
      </table>
    </div>
    {{/if}}

    {{#if buckets.31-60.length}}
    <div class="bucket-section bucket-60" style="margin-top:12px;">
      <div class="bucket-header">Retard 31 – 60 jours</div>
      <table>
        <thead>
          <tr>
            <th style="width:110px;">N° Facture</th>
            <th>Client</th>
            <th class="center" style="width:90px;">Échéance</th>
            <th class="center" style="width:70px;">Retard</th>
            <th class="right">Montant Dû (FCFA)</th>
          </tr>
        </thead>
        <tbody>
          {{#each buckets.31-60}}
          <tr>
            <td style="font-weight:600; color:#e65100;">{{numero}}</td>
            <td>{{clientNom}}</td>
            <td class="center">{{formatDate dateEcheance}}</td>
            <td class="center" style="color:#b71c1c; font-weight:600;">{{daysOverdue}} j</td>
            <td class="right">{{formatMontant montantDu}}</td>
          </tr>
          {{/each}}
          <tr class="subtotal-row">
            <td colspan="4">Sous-total 31–60 jours</td>
            <td class="right">{{formatMontant total31_60}} FCFA</td>
          </tr>
        </tbody>
      </table>
    </div>
    {{/if}}

    {{#if buckets.61-90.length}}
    <div class="bucket-section bucket-90" style="margin-top:12px;">
      <div class="bucket-header">Retard 61 – 90 jours</div>
      <table>
        <thead>
          <tr>
            <th style="width:110px;">N° Facture</th>
            <th>Client</th>
            <th class="center" style="width:90px;">Échéance</th>
            <th class="center" style="width:70px;">Retard</th>
            <th class="right">Montant Dû (FCFA)</th>
          </tr>
        </thead>
        <tbody>
          {{#each buckets.61-90}}
          <tr>
            <td style="font-weight:600; color:#c62828;">{{numero}}</td>
            <td>{{clientNom}}</td>
            <td class="center">{{formatDate dateEcheance}}</td>
            <td class="center" style="color:#b71c1c; font-weight:700;">{{daysOverdue}} j</td>
            <td class="right">{{formatMontant montantDu}}</td>
          </tr>
          {{/each}}
          <tr class="subtotal-row">
            <td colspan="4">Sous-total 61–90 jours</td>
            <td class="right">{{formatMontant total61_90}} FCFA</td>
          </tr>
        </tbody>
      </table>
    </div>
    {{/if}}

    {{#if buckets.>90.length}}
    <div class="bucket-section bucket-plus" style="margin-top:12px;">
      <div class="bucket-header">Retard &gt; 90 jours — Créances critiques</div>
      <table>
        <thead>
          <tr>
            <th style="width:110px;">N° Facture</th>
            <th>Client</th>
            <th class="center" style="width:90px;">Échéance</th>
            <th class="center" style="width:70px;">Retard</th>
            <th class="right">Montant Dû (FCFA)</th>
          </tr>
        </thead>
        <tbody>
          {{#each buckets.>90}}
          <tr>
            <td style="font-weight:700; color:#4a0000;">{{numero}}</td>
            <td>{{clientNom}}</td>
            <td class="center">{{formatDate dateEcheance}}</td>
            <td class="center" style="color:#4a0000; font-weight:700;">{{daysOverdue}} j</td>
            <td class="right" style="font-weight:700;">{{formatMontant montantDu}}</td>
          </tr>
          {{/each}}
          <tr class="subtotal-row">
            <td colspan="4">Sous-total &gt; 90 jours</td>
            <td class="right">{{formatMontant totalPlus90}} FCFA</td>
          </tr>
        </tbody>
      </table>
    </div>
    {{/if}}

  </div>

  <div class="grand-total">
    <span class="label">TOTAL DES CRÉANCES EN COURS</span>
    <span class="amount">{{formatMontant totalDu}} FCFA</span>
  </div>

  <div class="doc-footer">
    <span>Rapport de recouvrement — Créances au {{formatDate generatedAt}} — {{company.name}}</span>
    <span>FCFA (XOF) — Données: Factures non soldées</span>
  </div>

</body>
</html>
